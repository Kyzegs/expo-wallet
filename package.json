{
  "name": "@kyzegs/expo-wallet",
  "version": "0.2.0",
  "description": "Unified Apple Wallet and Google Wallet API for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc && tsc --build plugin",
    "clean": "node -e \"for (const dir of ['build', 'plugin/build']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "prepare": "npm run clean && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p plugin",
    "test": "jest",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-wallet",
    "apple-wallet",
    "google-wallet",
    "passkit",
    "pkpass",
    "wallet",
    "passes"
  ],
  "repository": "https://github.com/Kyzegs/expo-wallet",
  "bugs": {
    "url": "https://github.com/Kyzegs/expo-wallet/issues"
  },
  "author": "Sebastiaan <kyzegs@gmail.com> ()",
  "license": "MIT",
  "homepage": "https://github.com/Kyzegs/expo-wallet#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.12",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.0.0",
    "expo": "~57.0.24",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": ">=53.0.0",
    "expo-modules-core": "*",
    "react": "*",
    "react-native": "*"
  }
}
